# =============================================================================
# DevSpark — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# DevSpark supports two AI provider backends:
#   Option A: ZenMux (default)  — requires ZENMUX_API_KEY
#   Option B: OpenAI            — requires OPENAI_API_KEY
# =============================================================================

# ── AI Provider: ZenMux (default) ──────────────────────────────────────────
# Sign up at https://zenmux.com to get your API key.
# If unset, falls back to OPENAI_API_KEY.
ZENMUX_API_KEY=zk_your_zenmux_api_key_here

# ── AI Provider: OpenAI (fallback) ─────────────────────────────────────────
# Used when ZENMUX_API_KEY is not set.
# Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk_your_openai_api_key_here

# ── AI Provider: Featherless (alternative) ─────────────────────────────────
# Featherless offers serverless inference for open-weight models.
# Set ZENMUX_BASE_URL to your Featherless endpoint to use it.
# Example: ZENMUX_BASE_URL=https://api.featherless.ai/v1
# Sign up at https://featherless.ai
# FEATHERLESS_API_KEY=fl_your_featherless_key_here

# ── API Base URL ───────────────────────────────────────────────────────────
# Default: ZenMux API (https://api.zenmux.com/v1)
# For OpenAI:      https://api.openai.com/v1
# For Featherless: https://api.featherless.ai/v1
# For local LLM:   http://localhost:1234/v1  (LM Studio / Ollama)
ZENMUX_BASE_URL=https://api.zenmux.com/v1

# ── Model Selection ────────────────────────────────────────────────────────
# Primary model used for code reviews.
PRIMARY_MODEL=gpt-4o-mini

# Fallback model if the primary call fails.
# Set to a different model for redundancy (e.g. gpt-3.5-turbo).
FALLBACK_MODEL=gpt-4o-mini

# ── Bright Data (Guided Engineering Research) ─────────────────────────────
# Used by the backend to fetch real documentation/resources for each critique.
# Sign up at https://brightdata.com and create a SERP zone.
BRIGHTDATA_API_KEY=your_brightdata_api_key_here
BRIGHTDATA_ZONE=your_brightdata_zone_name_here

# ── Server Configuration ──────────────────────────────────────────────────
# Host and port for the FastAPI backend.
APP_HOST=0.0.0.0
APP_PORT=8000